<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jualn.miniapp.module.authorization.mapper.UnifiedMapper">
 <sql id="authorityColumns">id,grantee_user_id,granted_by,root_assignment_id,ceilings,member_bindings,recipient_rule,granted_at,expires_at,reason,revision,revoked_at,revoked_by,revocation_reason,change_id</sql>
 <select id="authority" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$AuthorityRow" flushCache="true" useCache="false">SELECT <include refid="authorityColumns"/> FROM rbac_delegation_authority WHERE id=#{id}</select>
 <select id="authorities" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$AuthorityRow" flushCache="true" useCache="false">SELECT <include refid="authorityColumns"/> FROM rbac_delegation_authority ORDER BY id</select>
 <insert id="insertAuthority">INSERT INTO rbac_delegation_authority(id,grantee_user_id,granted_by,root_assignment_id,ceilings,member_bindings,recipient_rule,granted_at,expires_at,reason,change_id) VALUES(#{id},#{granteeUserId},#{grantedBy},#{rootAssignmentId},#{ceilings},#{memberBindings},#{recipientRule},#{grantedAt},#{expiresAt},#{reason},#{changeId})</insert>
 <update id="revokeAuthority">UPDATE rbac_delegation_authority SET revoked_at=#{now},revoked_by=#{actor},revocation_reason=#{reason},revision=revision+1 WHERE id=#{id} AND revoked_at IS NULL</update>
 <select id="preview" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$PreviewRow" flushCache="true" useCache="false">SELECT id,actor,intent_json,snapshot_hash,created_at,expires_at FROM rbac_duty_preview WHERE id=#{id}</select>
 <insert id="insertPreview">INSERT INTO rbac_duty_preview(id,actor,intent_json,snapshot_hash,created_at,expires_at) VALUES(#{id},#{actor},#{intentJson},#{snapshotHash},#{createdAt},#{expiresAt})</insert>
 <select id="command" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$CommandRow" flushCache="true" useCache="false">SELECT id,actor,operation,target,command_key,fingerprint,request_json,result_json,audit_json,occurred_at FROM rbac_unified_command WHERE actor=#{actor} AND operation=#{operation} AND target=#{target} AND command_key=#{key}</select>
 <insert id="insertCommand">INSERT INTO rbac_unified_command(id,actor,operation,target,command_key,fingerprint,request_json,result_json,audit_json,occurred_at) VALUES(#{id},#{actor},#{operation},#{target},#{commandKey},#{fingerprint},#{requestJson},#{resultJson},#{auditJson},#{occurredAt})</insert>
 <select id="commandById" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$CommandRow" flushCache="true" useCache="false">SELECT id,actor,operation,target,command_key,fingerprint,request_json,result_json,audit_json,occurred_at FROM rbac_unified_command WHERE id=#{id}</select>
 <insert id="insertAssignment">INSERT INTO rbac_user_role_assignment(id,user_id,role_code,namespace,scope_type,granted_at,expires_at,version,grant_change_id,origin_kind,current_slot) VALUES(#{id},#{userId},#{roleCode},#{namespace},'GLOBAL',#{grantedAt},#{expiresAt},#{version},#{grantChangeId},'UNIFIED',NULL)</insert>
 <select id="cursor" resultType="cn.jualn.miniapp.module.authorization.model.UnifiedModels$CursorRow" flushCache="true" useCache="false">SELECT id,actor,binding,item_offset,expires_at FROM rbac_duty_cursor WHERE id=#{id}</select>
 <insert id="insertCursor">INSERT INTO rbac_duty_cursor(id,actor,binding,item_offset,expires_at) VALUES(#{id},#{actor},#{binding},#{itemOffset},#{expiresAt})</insert>
</mapper>
