<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jualn.miniapp.infrastructure.async.message.EventConsumptionMapper">
  <insert id="insert">
    INSERT INTO async_event_consumption(consumer_name,message_id) VALUES(#{consumerName},#{messageId})
  </insert>
  <delete id="deleteBefore">
    DELETE FROM async_event_consumption WHERE processed_at &lt; #{cutoff}
    ORDER BY processed_at LIMIT #{limit}
  </delete>
</mapper>
