<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jualn.miniapp.module.notify.mapper.NotificationPreferenceOwnerMapper">
  <select id="selectCanonicalUserIds" resultType="long">
    SELECT user_id FROM notification_preference_owner
    WHERE owner='CANONICAL' AND user_id IN
    <foreach collection="userIds" item="userId" open="(" separator="," close=")">#{userId}</foreach>
    ORDER BY user_id
  </select>
</mapper>
