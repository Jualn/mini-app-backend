<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jualn.miniapp.module.notify.mapper.NotificationPreferenceMapper">
  <select id="selectByUserIds" resultType="cn.jualn.miniapp.module.notify.entity.NotificationPreference">
    SELECT user_id, category, channel, enabled, source
    FROM notification_preference
    WHERE user_id IN
    <foreach collection="userIds" item="userId" open="(" separator="," close=")">#{userId}</foreach>
    ORDER BY user_id, category, channel
  </select>
</mapper>
