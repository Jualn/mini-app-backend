<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Levels belong to Boot logging.level properties; XML only owns output/retention. -->
    <springProperty name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>
    <conversionRule conversionWord="safeEx" class="cn.jualn.miniapp.common.observability.SafeStackTracePrinter"/>
    <conversionRule conversionWord="clr" class="cn.jualn.miniapp.common.observability.ConsoleColorConverter"/>
    <property name="LOG_DIR" value="${LOG_DIR:-/app/mini-app/logs}"/>
    <property name="MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-50MB}"/>
    <property name="TOTAL_SIZE" value="${LOG_TOTAL_SIZE:-1GB}"/>
    <property name="MAX_HISTORY" value="${LOG_MAX_HISTORY:-14}"/>
    <!-- Boot-based palette auto-detects terminal support; no caller/line-number collection. -->
    <property name="TEXT_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSSXXX,Asia/Shanghai}){faint} %clr(%-5level) %clr([%t]){faint} %clr(%-48logger{48}){blue} %clr(:){faint} %replace(%.-2048msg){'[\r\n\t]','_'} %kvp%clr(%replace( traceId=%X{traceId:-} operationId=%X{operationId:-} messageId=%X{messageId:-} jobId=%X{jobId:-} attempt=%X{attempt:-}){' (traceId|operationId|messageId|jobId|attempt)=(?= |$)',''}){faint}%n%safeEx"/>

    <!-- Development/default has safe readable output; DEBUG is an explicit, scoped diagnostic choice. -->
    <springProfile name="!prod">
        <appender name="OUTPUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${TEXT_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>
    <!-- Docker owns storage/rotation in the default production mode. No duplicate application file. -->
    <springProfile name="prod &amp; !log-file">
        <appender name="OUTPUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>logstash</format>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>
    <!-- Explicit non-container fallback: prod,log-file. Do not enable alongside container collection. -->
    <springProfile name="prod &amp; log-file">
        <appender name="OUTPUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/mini-app.log</file>
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>logstash</format>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/mini-app.%d{yyyy-MM-dd,Asia/Shanghai}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE}</totalSizeCap>
                <cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
        </appender>
    </springProfile>
    <springProfile name="prod">
        <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <maxFlushTime>5000</maxFlushTime>
            <appender-ref ref="OUTPUT"/>
        </appender>
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="ASYNC"/>
        </root>
    </springProfile>
    <springProfile name="!prod">
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="OUTPUT"/>
        </root>
    </springProfile>
</configuration>
